{
  "name": "prime-auto-care-manager",
  "version": "2.6.2",
  "private": true,
  "description": "Prime Auto Care Business Manager",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "npm run prepare:assets && electron .",
    "dist:win": "npm run prepare:assets && npm run validate && electron-builder --win nsis --x64",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "validate": "node scripts/validate-app.mjs",
    "prepare:branding": "python scripts/generate-brand-assets.py"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capgo/capacitor-file-sharer": "^8.1.16",
    "@capacitor/app-launcher": "^8.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "@andreeewill/exceljs": "5.0.3",
    "pdfmake": "0.2.23",
    "esbuild": "^0.25.0",
    "@capacitor/local-notifications": "^8.0.0"
  }
}
